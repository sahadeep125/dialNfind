# Server-side base URL of the DialNFind API
API_URL=http://localhost:4000/api/v1
# Same value as REVALIDATE_SECRET in server/.env. The API sends it to /api/revalidate to refresh cached pages
# after a change; without it, changes show only when a page's cache runs out.
REVALIDATE_SECRET=
# Header your host sets to the visitor's address and never passes through from the visitor, if any:
# x-real-ip behind nginx, cf-connecting-ip behind Cloudflare. Empty: the last X-Forwarded-For entry.
CLIENT_IP_HEADER=
# Public URL of the provider app (claim / list your business links)
NEXT_PUBLIC_PROVIDER_APP_URL=http://localhost:5173
# Map tiles and their required credit (defaults to OpenStreetMap; use a hosted tile service for heavy traffic)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Sign in with Google and Apple (docs/social-login.md). Leave empty to hide a button.
# Google: the Web OAuth client ID. Apple: the Services ID and a Return URL registered on it (https only).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_SERVICES_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://dialnfind.com/login
# Origins whose images Next may resize: the API (PUBLIC_URL in server/.env) and any storage CDN, comma-separated.
# Images linked from other hosts still show, just without resizing.
NEXT_PUBLIC_IMAGE_ORIGINS=http://localhost:4000
# Public address of this site: canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://dialnfind.com
# Google Search Console verification token (optional).
GOOGLE_SITE_VERIFICATION=
# App links: iOS team ID and the Android signing certificate SHA-256 fingerprints (comma-separated, from Play Console > App integrity).
APPLE_TEAM_ID=9HH33XNTUX
IOS_BUNDLE_ID=com.dialnfind.app
ANDROID_PACKAGE=com.dialnfind.app
ANDROID_SHA256_CERT_FINGERPRINTS=
# App store listings for the home page "Get the app" banner. Leave both empty to hide it.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
# Office shown on the contact page and in the footer (leave empty to hide).
NEXT_PUBLIC_OFFICE_ADDRESS=
NEXT_PUBLIC_OFFICE_REGION=
# Error reporting (Sentry). Leave the DSN empty to turn it off. Org, project and auth token upload source maps at build time.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=production
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Product analytics (PostHog). One project for every app; this is its project token (phc_...). Leave empty to
# send nothing. Browser events go to /ingest on this site, which next.config.ts passes on to POSTHOG_INGEST_HOST.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
POSTHOG_INGEST_HOST=https://us.i.posthog.com
