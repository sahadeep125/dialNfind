# Server-side base URL of the DialNFind API
API_URL=http://localhost:4000/api/v1
# Public URL of the provider app (claim / list your business links)
NEXT_PUBLIC_PROVIDER_APP_URL=http://localhost:5173
# Map tiles and their required credit (defaults to OpenStreetMap; use a hosted tile service for heavy traffic)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Sign in with Google and Apple (docs/social-login.md). Leave empty to hide a button.
# Google: the Web OAuth client ID. Apple: the Services ID and a Return URL registered on it (https only).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_SERVICES_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://dialnfind.com/login
# Origins whose images Next may resize: the API (PUBLIC_URL in server/.env) and any storage CDN, comma-separated.
# Images linked from other hosts still show, just without resizing.
NEXT_PUBLIC_IMAGE_ORIGINS=http://localhost:4000
