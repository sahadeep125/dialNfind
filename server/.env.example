DATABASE_URL="postgresql://dialnfind:dialnfind@localhost:5432/dialnfind?schema=public"
PORT=4000
JWT_SECRET="change-me-in-production"
# How long a sign-in lasts: customers and providers in days, admin team members in hours
SESSION_DAYS="30"
STAFF_SESSION_HOURS="12"
# Scales all request rate limits (2 = double). 0 turns them off; never do that in production.
RATE_LIMIT_MULTIPLIER="1"
# Comma separated origins allowed by CORS (web, provider and super-admin apps, plus the mobile app in a browser)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8081"

# Public origin of this API (used in uploaded file URLs) and where uploads are stored on disk
PUBLIC_URL="http://localhost:4000"
UPLOAD_DIR="uploads"
# Documents (ID proofs, ownership papers, support attachments) live here and are only served through signed links
UPLOAD_PRIVATE_DIR="uploads-private"

# Links in emails (password reset, email verification) and the provider portal
WEB_URL="http://localhost:3000"
PROVIDER_URL="http://localhost:5173"
# Super admin console; linked from the staff morning digest email.
ADMIN_URL="http://localhost:5174"

# Outgoing email. Leave SMTP_HOST empty in development: emails are printed to the server console.
# Port 465 uses TLS from the start; 587 upgrades with STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="DialNFind <no-reply@dialnfind.com>"
# Reply-To on account emails, so replies to no-reply messages reach the team.
SUPPORT_EMAIL="support@dialnfind.com"

# Scheduled jobs: plan expiry and reminders, finished promotions, nightly ranking, cleanup.
# Set to "true" in exactly one running API instance.
RUN_JOBS="true"

# Place search and address lookup (OpenStreetMap Nominatim by default, free, max 1 request/second).
# Put a real contact email in the User-Agent: the Nominatim usage policy requires it.
GEOCODER_URL="https://nominatim.openstreetmap.org"
GEOCODER_USER_AGENT="DialNFind/1.0 (support@dialnfind.com)"
GEOCODER_COUNTRY="in"
GEOCODER_ENABLED="true"

# Sign in with Google and Apple (docs/social-login.md). Leave a provider's IDs empty to switch it off.
# Google: every OAuth client whose ID tokens are accepted (the web client ID is what the mobile apps send too).
GOOGLE_CLIENT_IDS=""
# Apple: the iOS bundle IDs plus the Services ID used by the websites and Android.
APPLE_CLIENT_IDS="com.dialnfind.app,com.dialnfind.business"
APPLE_SERVICES_ID=""
# Sign in with Apple key (.p8). Needed to revoke Apple access when someone deletes their account.
# Paste the key on one line with \n for line breaks.
APPLE_TEAM_ID="9HH33XNTUX"
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
# App URL schemes the Android "Sign in with Apple" callback may redirect to
APPLE_APP_REDIRECT_SCHEMES="dialnfind,dialnfind-business"

# Web payments with Razorpay Subscriptions (docs/billing.md). Use test keys (rzp_test_...) outside production.
# The webhook secret is the one you set on the Razorpay webhook for https://<api>/api/v1/webhooks/razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# In-app purchases in the provider app, through RevenueCat. The secret key (sk_...) reads subscribers.
# REVENUECAT_WEBHOOK_AUTH must equal the Authorization header value set on the RevenueCat webhook.
# The project id is only used to link from the admin console to RevenueCat customers.
REVENUECAT_SECRET_KEY=""
REVENUECAT_WEBHOOK_AUTH=""
REVENUECAT_PROJECT_ID=""
