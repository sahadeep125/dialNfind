DATABASE_URL="postgresql://dialnfind:dialnfind@localhost:5432/dialnfind?schema=public"
PORT=4000
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="30d"
# Comma separated origins allowed by CORS (web, provider and super-admin apps)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5174"
# Development-only verification code for claim/phone OTP (SMS gateway not wired yet)
DEV_OTP_CODE="123456"
# Leave empty until credentials exist; the endpoints return 501 while unset
GOOGLE_CLIENT_ID=""
APPLE_CLIENT_ID=""
PAYMENT_GATEWAY_KEY=""

# Public origin of this API (used in uploaded file URLs) and where uploads are stored on disk
PUBLIC_URL="http://localhost:4000"
UPLOAD_DIR="uploads"
