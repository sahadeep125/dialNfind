# ==========================================
# KaajVa Production Configuration (.env)
# ==========================================

# 1. Database Credentials
POSTGRES_USER=kaajva
# Set a strong password before the FIRST deploy (openssl rand -hex 24). Postgres keeps the password it was
# created with, so changing it later on an existing database also needs ALTER USER inside the database.
POSTGRES_PASSWORD=6f03500a587db06f4403a9cac6ef870dd131604028faf917
POSTGRES_DB=kaajva

# 2. Public URLs (Replace with your domain names configured in Cloudflare Tunnel)
# Main website (Next.js SEO friendly app)
WEB_URL=https://kaajva.in

# Backend API server (Express)
PUBLIC_URL=https://api.kaajva.in

# Provider dashboard (React SPA)
PROVIDER_URL=https://business.kaajva.in

# Admin console (React SPA)
ADMIN_URL=https://admin.kaajva.in

# Allowed CORS origins (comma separated)
CORS_ORIGINS=https://kaajva.in,https://business.kaajva.in,https://admin.kaajva.in

# Ports are published on 127.0.0.1 only, for Cloudflare Tunnel on this machine. 0.0.0.0 opens them to the
# network (only behind a firewall).
BIND_ADDRESS=127.0.0.1

# 3. Security & Admin Secrets
# Generate a strong random 32+ char secret (e.g. run `openssl rand -base64 32`)
JWT_SECRET=6f03500a587db06f4403a9cac6ef870dd131604028faf917
# Shared by the API and the website: the API uses it to tell the website to refresh cached pages after a
# change, so edits show up straight away (openssl rand -hex 32).
REVALIDATE_SECRET=6f03500a587db06f4403a9cac6ef870dd131604028faf917

# Initial Super Admin user (Used ONLY on first bootstrap, change password after first sign-in).
# Never commit the real values: put them only in .env on the server.
BOOTSTRAP_ADMIN_EMAIL=kaajvaofficial@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=2026@kaajva

# 4. SMTP Email Setup (sign-up codes, email verification, password resets). Required in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# The mail account that sends email. With Gmail this is the Gmail address and SMTP_PASS is an app password.
# The API refuses to start in production while these are still the example values.
SMTP_USER=kaajvaofficial@gmail.com
# The 16-letter Gmail app password (Google Account > Security > 2-Step Verification > App passwords).
# Set it only in .env on the server, in quotes because it has spaces: SMTP_PASS="abcd efgh ijkl mnop"
SMTP_PASS=cicx odfb wezr kfyy
# Leave empty to send from SMTP_USER (Gmail rewrites any other From address).
SMTP_FROM=
# Inbox for replies and the address shown in the geocoder User-Agent. Defaults to SMTP_USER.
SUPPORT_EMAIL=support@kaajva.in


# 5. Search engines (optional). Paste only the content="..." value of each verification meta tag.
# Google Search Console > Add property > URL prefix > HTML tag.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools > Add site > HTML Meta Tag (msvalidate.01).
BING_SITE_VERIFICATION=
# Extra public profiles, comma separated (Google Business Profile, LinkedIn, Justdial...). Facebook, Instagram,
# YouTube and X are already built in (web/lib/config.ts).
SOCIAL_LINKS=

# Analytics (docs/ANALYTICS.md). docker-compose.yml already defaults both to KaajVa's public IDs;
# set them here only to change them, or set them empty to turn tracking off (for example on a test copy).
# POSTHOG_KEY=phc_...
# GTM_ID=GTM-...

# 6. Sign in with Google (docs/social-login.md). Google Cloud Console → APIs & Services → Credentials.
# API: every client ID that may sign in (web, traveler iOS app, host iOS app), comma separated.
GOOGLE_CLIENT_IDS=469697081228-0q162r7ge5ki24fl1t6ofvq9n4pdtskf.apps.googleusercontent.com,469697081228-r4hhdac107tr62bas8d6pgug3cp84q5c.apps.googleusercontent.com,469697081228-cm8i8n7o6iaqd8tm2vrtkbut28h731ab.apps.googleusercontent.com
# Website button (the web client ID). The host dashboard uses the same one unless VITE_GOOGLE_CLIENT_ID is set.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=469697081228-0q162r7ge5ki24fl1t6ofvq9n4pdtskf.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=469697081228-0q162r7ge5ki24fl1t6ofvq9n4pdtskf.apps.googleusercontent.com

# 7. Sign in with Apple (docs/social-login.md). Apple Developer → Certificates, Identifiers & Profiles.
# Required on iOS because Google sign-in is offered. Empty hides the Apple buttons.
# Every audience that may sign in: both bundle IDs and the Services ID, comma separated.
APPLE_CLIENT_IDS=com.kaajva.app,com.kaajva.business
# The Services ID used by the website and host dashboard (also add it to APPLE_CLIENT_IDS once created).
APPLE_SERVICES_ID=com.kaajva.signin
APPLE_TEAM_ID=9HH33XNTUX
# The Sign in with Apple key (Keys → +), used to revoke Apple access when an account is deleted.
APPLE_KEY_ID=7MS3ZZGJ58
# The .p8 file's contents on one line, with \n for line breaks, in double quotes.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQgqwrHfd67D3sCgFJb
cjY7KBQgSXijGLPcpIJpH5G0NQugCgYIKoZIzj0DAQehRANCAARCrJWfgIufmqld
pyTKGCyphqOHjbid0txY91ebLDEJ1UdAK2HG/F+xhzv65cKy6+0vXRhVWHEWMUO6
Sqfah6pj
-----END PRIVATE KEY-----"
APPLE_APP_REDIRECT_SCHEMES=kaajva,kaajva-host
# Return URLs default to WEB_URL/login and HOST_URL/login; set these only to use different ones.
NEXT_PUBLIC_APPLE_REDIRECT_URI=
VITE_APPLE_REDIRECT_URI=

# 8. Website extras (compiled into the site at build time; empty leaves each out)
# Error reports (Sentry project kaajva-web → Client Keys).
NEXT_PUBLIC_SENTRY_DSN=https://2e6a44c1ee59a507ff8ff48f5af5046b@o4512195755311104.ingest.us.sentry.io/4512199718862848
# Store badges, once the apps are live.
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/us/app/id6772877735
# Play: https://play.google.com/store/apps/details?id=com.kaajva.app (set once the listing is public).
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.kaajva.app
# Office address on the Contact page, and the region in the footer.
NEXT_PUBLIC_OFFICE_ADDRESS=Ghogomali, Siliguri, West Bengal 734006, India
NEXT_PUBLIC_OFFICE_REGION=Siliguri, West Bengal