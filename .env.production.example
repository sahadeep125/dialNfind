# ==========================================
# DialNFind Production Configuration (.env)
# ==========================================

# 1. Database Credentials
POSTGRES_USER=dialnfind
POSTGRES_PASSWORD=replace_with_strong_password_123
POSTGRES_DB=dialnfind

# 2. Public URLs (Replace with your domain names configured in Cloudflare Tunnel)
# Main website (Next.js SEO friendly app)
WEB_URL=https://dialnfind.dsahathemes.in

# Backend API server (Express)
PUBLIC_URL=https://api.dialnfind.dsahathemes.in

# Provider dashboard (React SPA)
PROVIDER_URL=https://providers.dialnfind.dsahathemes.in

# Admin console (React SPA)
ADMIN_URL=https://admin.dialnfind.dsahathemes.in

# Allowed CORS origins (comma separated)
CORS_ORIGINS=https://dialnfind.dsahathemes.in,https://providers.dialnfind.dsahathemes.in,https://admin.dialnfind.dsahathemes.in

# 3. Security & Admin Secrets
# Generate a strong random 32+ char secret (e.g. run `openssl rand -base64 32`)
JWT_SECRET=replace_with_super_secret_jwt_key_minimum_32_characters_long

# Initial Super Admin user (Used ONLY on first bootstrap, change password after first sign-in)
BOOTSTRAP_ADMIN_EMAIL=admin@dialnfind.com
BOOTSTRAP_ADMIN_PASSWORD=InitialAdminPassword123!

# 4. Optional SMTP Email Setup (For email verification / password resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="DialNFind <no-reply@dialnfind.com>"
