{
  "expo": {
    "name": "KaajVa",
    "slug": "kaajva",
    "scheme": "kaajva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kaajva.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KaajVa uses your location to show service providers near you."
      },
      "appleTeamId": "9HH33XNTUX",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:kaajva.in"
      ],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kaajva.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kaajva.in",
              "pathPrefix": "/providers"
            },
            {
              "scheme": "https",
              "host": "kaajva.in",
              "pathPrefix": "/services"
            },
            {
              "scheme": "https",
              "host": "kaajva.in",
              "pathPrefix": "/search"
            },
            {
              "scheme": "https",
              "host": "kaajva.in",
              "pathPrefix": "/dashboard/notifications"
            },
            {
              "scheme": "https",
              "host": "kaajva.in",
              "pathPrefix": "/dashboard/support"
            },
            {
              "scheme": "https",
              "host": "kaajva.in",
              "pathPrefix": "/dashboard/contacts"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.kaajva.app",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#042161",
          "dark": {
            "backgroundColor": "#010B2B"
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-image",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KaajVa uses your location to show service providers near you.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-asset",
      "expo-apple-authentication",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KaajVa uses your photos for your profile picture, review photos and support requests.",
          "cameraPermission": "KaajVa uses the camera to take photos for your reviews and support requests.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FD8003"
        }
      ],
      "./plugins/withSceneLifecycle",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
