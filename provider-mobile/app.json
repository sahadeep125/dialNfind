{
  "expo": {
    "name": "KaajVa Business",
    "slug": "kaajva-business",
    "scheme": "kaajva-business",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kaajva.business",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KaajVa Business uses your location to place your business on the map.",
        "NSPhotoLibraryUsageDescription": "KaajVa Business uses your photos for your logo, cover and past work.",
        "NSCameraUsageDescription": "KaajVa Business uses the camera to photograph your work and documents."
      },
      "appleTeamId": "9HH33XNTUX",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kaajva.business",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.kaajva.business",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#042161",
          "dark": {
            "backgroundColor": "#010B2B"
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-image",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KaajVa Business uses your location to place your business on the map.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "KaajVa Business uses your photos for your logo, cover and past work.",
          "cameraPermission": "KaajVa Business uses the camera to photograph your work and documents.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FD8003"
        }
      ],
      "./plugins/withSceneLifecycle",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
