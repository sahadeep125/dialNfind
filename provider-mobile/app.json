{
  "expo": {
    "name": "DialNFind Business",
    "slug": "dialnfind-business",
    "scheme": "dialnfind-business",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dialnfind.business",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DialNFind Business uses your location to place your business on the map.",
        "NSPhotoLibraryUsageDescription": "DialNFind Business uses your photos for your logo, cover and past work.",
        "NSCameraUsageDescription": "DialNFind Business uses the camera to photograph your work and documents."
      },
      "appleTeamId": "9HH33XNTUX"
    },
    "android": {
      "package": "com.dialnfind.business",
      "adaptiveIcon": {
        "backgroundColor": "#355EDD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#355EDD",
          "dark": {
            "backgroundColor": "#0B0F18"
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-image",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DialNFind Business uses your location to place your business on the map."
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "DialNFind Business uses your photos for your logo, cover and past work.",
          "cameraPermission": "DialNFind Business uses the camera to photograph your work and documents."
        }
      ],
            "./plugins/withSceneLifecycle"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
