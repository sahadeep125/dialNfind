# Base URL of the DialNFind API. On a phone, use your computer's LAN address, e.g. http://192.168.1.20:4000/api/v1.
# The Android emulator reaches your computer at http://10.0.2.2:4000/api/v1.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
# Public website, used for the terms and privacy pages.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# Sign in with Google and Apple (docs/social-login.md). Leave empty to hide a button. Changing these needs a new build.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Apple on Android uses Apple's web flow; the API must be on https for it (APPLE_SERVICES_ID on the server too).
EXPO_PUBLIC_APPLE_SERVICES_ID=
