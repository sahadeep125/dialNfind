# Copy to .env and fill in. Values here override config.yaml; CLI flags override both.

# Contact address placed in the crawler's User-Agent so site owners can reach you.
CONTACT_EMAIL=you@yourdomain.com

# Crawl politeness
REQUEST_DELAY=2
MAX_CONCURRENT_DOMAINS=3
MAX_PAGES_PER_DOMAIN=5

# Licensed search API (optional). Only official JSON APIs are used -- never search result HTML.
# SEARCH_API_PROVIDER=brave        # brave | google_cse
# BRAVE_SEARCH_API_KEY=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=

# Foursquare OS Places (optional; source `fsq`). A Foursquare Places Portal or Hugging Face token with
# access to foursquare/fsq-os-places, and the release folder to read (dt=YYYY-MM-DD).
# FSQ_TOKEN=
# FSQ_RELEASE_DATE=

# Geocoding (optional). none | nominatim | opencage
GEOCODING_PROVIDER=none
# GEOCODING_API_KEY=               # required for opencage

# Optional AI classification (--use-ai-classification). Requires `pip install anthropic`.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
