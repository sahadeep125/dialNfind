# Base URL of the DialNFind API
VITE_API_URL=http://localhost:4000/api/v1
# Public customer website (for "View public profile" links)
VITE_WEB_URL=http://localhost:3000
# Map tiles and their required credit (defaults to OpenStreetMap)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Sign in with Google and Apple (docs/social-login.md). Leave empty to hide a button.
# Google: the Web OAuth client ID. Apple: the Services ID and a Return URL registered on it (https only).
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_SERVICES_ID=
VITE_APPLE_REDIRECT_URI=https://business.dialnfind.com/login

# Product analytics (PostHog). One project for every app; this is its project token (phc_...). Leave empty to
# send nothing. /ingest goes through this origin (vite.config.ts in development, deploy/spa-nginx.conf in production).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=/ingest
VITE_APP_ENV=production
